# ==============================================================================
# S.A.R.T.H.I. Backend Environment Configuration
# Copy this file to backend/.env and fill in your actual MySQL credentials.
# Never commit backend/.env to version control.
# ==============================================================================

# Hostname or IP address of the MySQL server (used by backend/database.py)
DB_HOST=localhost

# TCP port of the MySQL server (defaults to 3306 if omitted)
DB_PORT=3306

# Target MySQL database schema name containing soldiers, fitness, health, injury, and history tables
DB_NAME=sarthi_db

# MySQL username with SELECT and INSERT permissions on the target database
DB_USER=root

# MySQL password for DB_USER (replace with a strong password in production)
DB_PASSWORD=your_mysql_password

# Comma-separated list of additional frontend origins permitted by FastAPI CORS (used by backend/main.py)
ALLOWED_ORIGINS=https://your-frontend.netlify.app,https://your-frontend.vercel.app
